<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body>

    <%- include('../partials/navbar') %>

    <main>
        <div class="container" id="edit-view">

            <form class="structured-form" action="/edit-Book/<%= book._id %>" method="POST" enctype="multipart/form-data">
                
                <div class="form-layout">
                    <div class="form-details">
                        <h3 class="form-section-title">Manuscript Details</h3>
                        
                        <div class="form-group full-width">
                            <label for="title">Title</label>
                            <input type="text" id="title" name="Title" required value="<%= book.Title %>">
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="author">Author</label>
                                <input type="text" id="author" name="Author" required value="<%= book.Author %>">
                            </div>
                            <div class="form-group">
                                <label for="category">Category</label>
                                <input type="text" id="category" name="Category" required value="<%= book.Category.join(', ') %>">
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="price">Price ($)</label>
                                <input type="number" id="price" name="Price" step="0.01" min="0" required value="<%= book.Price %>">
                            </div>
                            <div class="form-group">
                                <label for="quantity">Quantity in Stock</label>
                                <input type="number" id="quantity" name="Quantity" min="0" required value="<%= book.Quantity %>">
                            </div>
                        </div>

                        <div class="form-group full-width no-bottom-margin">
                            <label for="description">Description</label>
                            <textarea id="description" name="Description" required><%= book.Description %></textarea>
                        </div>
                    </div>

                    <div class="form-media">
                        <h3 class="form-section-title">Cover Artwork</h3>
                        
                        <div class="upload-area">
                            <input type="file" id="image" name="Image" accept="image/*" class="hidden-file-input">
                            
                            <div class="upload-placeholder is-hidden" id="upload-placeholder">
                                <div class="upload-icon">⇪</div>
                                <span>Select a new file</span>
                                <small>JPEG, PNG, WEBP accepted</small>
                            </div>

                            <img id="image-preview" class="is-visible" src="/uploads/<%= book.Image %>" alt="Cover Preview">
                        </div>
                        <small class="current-cover-note">
                            Click the image to upload a replacement. Leave blank to keep the current cover.
                        </small>
                    </div>
                </div>

                <button type="submit" class="submit-btn">Save Changes</button>
            </form>
        </div>
    </main>

    <%- include('../partials/footer') %>

    <script>
        document.getElementById('image').addEventListener('change', function(event) {
            const file = event.target.files[0];
            const imagePreview = document.getElementById('image-preview');
            const placeholder = document.getElementById('upload-placeholder');
            
            // Store the original image URL so we can revert if they cancel
            const originalImageSrc = "<%= book.Image ? '/uploads/' + book.Image : '' %>";

            if (file) {
                // Create temp URL for the new file
                const objectURL = URL.createObjectURL(file);
                
                // Set image source and show it
                imagePreview.src = objectURL;
                imagePreview.classList.remove('is-hidden');
                imagePreview.classList.add('is-visible');
                placeholder.classList.remove('is-visible');
                placeholder.classList.add('is-hidden');

                imagePreview.onload = function() {
                    URL.revokeObjectURL(imagePreview.src); // free memory
                }
            } else {
                // If user opens the file dialog but clicks "Cancel", revert to the original database image
                if (originalImageSrc) {
                    imagePreview.src = originalImageSrc;
                    imagePreview.classList.remove('is-hidden');
                    imagePreview.classList.add('is-visible');
                    placeholder.classList.remove('is-visible');
                    placeholder.classList.add('is-hidden');
                } else {
                    imagePreview.src = '';
                    imagePreview.classList.remove('is-visible');
                    imagePreview.classList.add('is-hidden');
                    placeholder.classList.remove('is-hidden');
                    placeholder.classList.add('is-visible');
                }
            }
        });
    </script>
</body>
</html>
