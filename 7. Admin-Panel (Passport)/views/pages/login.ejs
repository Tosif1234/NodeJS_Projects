  </span>
</span>
              <span class="app-brand-text demo text-heading fw-semibold fs-4">Materio</span>
            </a>
          </div>

          <% if (error) { %>
  <div class="alert alert-danger alert-dismissible fade show text-center d-flex align-items-center justify-content-center py-3 mb-3" role="alert">
    <small class="mb-0"><%= error %></small>
    <button type="button" class="btn-close m-0 p-0 position-absolute top-50 end-0 translate-middle-y me-3" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

          <h5 class="mb-1 text-center">Welcome to Materio! 👋🏻</h5>
          <p class="mb-7 text-center text-muted small">Please sign-in to your account and start the adventure</p>

          <form id="formAuthentication" action="/login" method="POST">
            <div class="form-floating form-floating-outline mb-3">
              <input type="text" class="form-control" id="email" name="email" placeholder="Email or Username" autofocus />
              <label for="email">Email or Username</label>
            </div>

            <div class="mb-3">
              <div class="form-password-toggle">
                <div class="input-group input-group-merge">
                  <div class="form-floating form-floating-outline">
                    <input type="password" id="password" class="form-control" name="password" placeholder="············" />
                    <label for="password">Password</label>
                  </div>
                  <span class="input-group-text cursor-pointer" id="togglePassword">
                    <i class="icon-base ri ri-eye-off-line"></i>
                  </span>
                </div>
              </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
              <div class="form-check mb-0">
                <input class="form-check-input" type="checkbox" id="remember-me" />
                <label class="form-check-label small" for="remember-me">Remember Me</label>
              </div>
              <a href="auth-forgot-password-basic.html" class="small text-decoration-none">Forgot Password?</a>
            </div>

            <button class="btn btn-primary d-grid w-100 mb-3 py-2" type="submit" style="background-color: #8C57FF; border-color: #8C57FF;">Login</button>
          </form>

          <p class="text-center mb-4 small">
            <span>New here?</span>
            <a href="/register" class="text-decoration-none">Create account</a>
          </p>

          <div class="divider my-4">
            <div class="divider-text text-muted">or</div>
          </div>

          <!-- Font Awesome Social Icons -->
          <div class="d-flex justify-content-center gap-5">
            <a href="https://www.facebook.com/Meta" class="text-facebook fs-4">
              <i class="fab fa-facebook-f"></i>
            </a>
            <a href="https://x.com/" class="text-twitter fs-4">
              <i class="fab fa-twitter"></i>
            </a>
            <a href="https://github.com/Tosif1234" class="text-github fs-4" style="color: #333;">
              <i class="fab fa-github"></i>
            </a>
            <a href="https://www.google.com/" class="text-google fs-4" style="color: #db4437;">
              <i class="fab fa-google"></i>
            </a>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>
<!-- Background Illustrations (The "Trees" from your screenshot) -->
<img 
  src="../assets/img/illustrations/tree-3.png" 
  alt="auth-tree" 
  class="d-none d-lg-block" 
  style="position: fixed; left: 4%; bottom: 0; z-index: -1; width: 120px;" 
/>

<img 
  src="../assets/img/illustrations/tree.png" 
  alt="auth-tree" 
  class="d-none d-lg-block" 
  style="position: fixed; right: 4%; bottom: 0; z-index: -1; width: 100px;" 
/>

