<aside id="layout-menu" class="layout-menu menu-vertical menu">
  <%
    var checkPermission = typeof canPermission === 'function' ? canPermission : function () { return false; };
    var canUsers = checkPermission('users:manage');
    var canCategories = checkPermission('categories:manage');
    var canSubcategories = checkPermission('subcategories:manage');
    var canExtraCategories = checkPermission('extraCategories:manage');
    var canProductView = checkPermission('products:view');
    var canProductCreate = checkPermission('products:create');
    var canProductTrash = checkPermission('products:trash');
    var showStoreMenu = canUsers || canCategories || canSubcategories || canExtraCategories || canProductView;
  %>
  
  <div class="app-brand demo ">
    <a href="/" class="app-brand-link gap-xl-0 gap-2">
      <span class="app-brand-logo demo me-1">
        <span class="text-primary">
          <svg width="30" height="24" viewBox="0 0 250 196" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12.3002 1.25469L56.655 28.6432C59.0349 30.1128 60.4839 32.711 60.4839 35.5089V160.63C60.4839 163.468 58.9941 166.097 56.5603 167.553L12.2055 194.107C8.3836 196.395 3.43136 195.15 1.14435 191.327C0.395485 190.075 0 188.643 0 187.184V8.12039C0 3.66447 3.61061 0.0522461 8.06452 0.0522461C9.56056 0.0522461 11.0271 0.468577 12.3002 1.25469Z" fill="currentColor" />
            <path opacity="0.077704" fill-rule="evenodd" clip-rule="evenodd" d="M0 65.2656L60.4839 99.9629V133.979L0 65.2656Z" fill="black" />
            <path opacity="0.077704" fill-rule="evenodd" clip-rule="evenodd" d="M0 65.2656L60.4839 99.0795V119.859L0 65.2656Z" fill="black" />
            <path fill-rule="evenodd" clip-rule="evenodd" d="M237.71 1.22393L193.355 28.5207C190.97 29.9889 189.516 32.5905 189.516 35.3927V160.631C189.516 163.469 191.006 166.098 193.44 167.555L237.794 194.108C241.616 196.396 246.569 195.151 248.856 191.328C249.605 190.076 250 188.644 250 187.185V8.09597C250 3.64006 246.389 0.027832 241.935 0.027832C240.444 0.027832 238.981 0.441882 237.71 1.22393Z" fill="currentColor" />
            <path opacity="0.077704" fill-rule="evenodd" clip-rule="evenodd" d="M250 65.2656L189.516 99.8897V135.006L250 65.2656Z" fill="black" />
            <path opacity="0.077704" fill-rule="evenodd" clip-rule="evenodd" d="M250 65.2656L189.516 99.0497V120.886L250 65.2656Z" fill="black" />
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12.2787 1.18923L125 70.3075V136.87L0 65.2465V8.06814C0 3.61223 3.61061 0 8.06452 0C9.552 0 11.0105 0.411583 12.2787 1.18923Z" fill="currentColor" />
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12.2787 1.18923L125 70.3075V136.87L0 65.2465V8.06814C0 3.61223 3.61061 0 8.06452 0C9.552 0 11.0105 0.411583 12.2787 1.18923Z" fill="white" fill-opacity="0.15" />
            <path fill-rule="evenodd" clip-rule="evenodd" d="M237.721 1.18923L125 70.3075V136.87L250 65.2465V8.06814C250 3.61223 246.389 0 241.935 0C240.448 0 238.99 0.411583 237.721 1.18923Z" fill="currentColor" />
            <path fill-rule="evenodd" clip-rule="evenodd" d="M237.721 1.18923L125 70.3075V136.87L250 65.2465V8.06814C250 3.61223 246.389 0 241.935 0C240.448 0 238.99 0.411583 237.721 1.18923Z" fill="white" fill-opacity="0.3" />
          </svg>
        </span>
      </span>
      <span class="app-brand-text demo menu-text fw-semibold ms-2">AdminPanel</span>
    </a>

    <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto">
      <i class="menu-toggle-icon d-xl-inline-block align-middle"></i>
    </a>
  </div>

  <div class="menu-inner-shadow"></div>

  <ul class="menu-inner py-1">
    
    <li class="menu-header small text-uppercase">
      <span class="menu-header-text" data-i18n="Main Menu">Main Menu</span>
    </li>
    
    <li class="menu-item <%= activePage === 'dashboard' ? 'active' : '' %>">
      <a href="/dashboard" class="menu-link">
        <i class="menu-icon icon-base ri ri-dashboard-3-line"></i>
        <div data-i18n="Dashboard Overview">Dashboard Overview</div>
      </a>
    </li>
    
    <% if (showStoreMenu) { %>
      <li class="menu-header small text-uppercase">
        <span class="menu-header-text" data-i18n="Store Management">Store Management</span>
      </li>
    <% } %>

    <% if (canUsers) { %>
      <li class="menu-item <%= ['add-user', 'view-users', 'trash-users'].includes(activePage) ? 'active open' : '' %>">
      <a href="javascript:void(0);" class="menu-link menu-toggle">
        <i class="menu-icon icon-base ri ri-group-line"></i>
        <div data-i18n="User Management">User Management</div>
      </a>
      <ul class="menu-sub">
        <li class="menu-item <%= activePage === 'add-user' ? 'active' : '' %>">
          <a href="/form-layout" class="menu-link">
            <i class="menu-icon ri ri-user-add-line"></i>
            <div data-i18n="Add New User">Add New User</div>
          </a>
        </li>
        <li class="menu-item <%= activePage === 'view-users' ? 'active' : '' %>">
          <a href="/users" class="menu-link">
            <i class="menu-icon ri ri-list-check-2"></i>
            <div data-i18n="All Users">All Users</div>
          </a>
        </li>
        <li class="menu-item <%= activePage === 'trash-users' ? 'active' : '' %>">
          <a href="/users/trash" class="menu-link">
            <i class="menu-icon ri ri-delete-bin-2-line"></i>
            <div data-i18n="Deleted Users">Deleted Users</div>
          </a>
        </li>
      </ul>
    </li>
    <% } %>

    <% if (canCategories) { %>
      <li class="menu-item <%= ['add-category', 'view-category', 'trash-category'].includes(activePage) ? 'active open' : '' %>">
      <a href="javascript:void(0);" class="menu-link menu-toggle">
        <i class="menu-icon icon-base ri ri-folder-2-line"></i>
        <div data-i18n="Categories">Categories</div>
      </a>
      <ul class="menu-sub">
        <li class="menu-item <%= activePage === 'add-category' ? 'active' : '' %>">
          <a href="/category/add" class="menu-link">
            <i class="menu-icon ri ri-folder-add-line"></i>
            <div data-i18n="Create Category">Create Category</div>
          </a>
        </li>
        <li class="menu-item <%= activePage === 'view-category' ? 'active' : '' %>">
          <a href="/category/view" class="menu-link">
            <i class="menu-icon ri ri-list-check-2"></i>
            <div data-i18n="Manage Categories">Manage Categories</div>
          </a>
        </li>
        <li class="menu-item <%= activePage === 'trash-category' ? 'active' : '' %>">
          <a href="/category/trash" class="menu-link">
            <i class="menu-icon ri ri-archive-line"></i>
            <div data-i18n="Archived Categories">Archived Categories</div>
          </a>
        </li>
      </ul>
    </li>
    <% } %>

    <% if (canSubcategories) { %>
      <li class="menu-item <%= ['add-subcategory', 'view-subcategory', 'trash-subcategory'].includes(activePage) ? 'active open' : '' %>">
      <a href="javascript:void(0);" class="menu-link menu-toggle">
        <i class="menu-icon icon-base ri ri-node-tree"></i>
        <div data-i18n="Subcategories">Subcategories</div>
      </a>
      <ul class="menu-sub">
        <li class="menu-item <%= activePage === 'add-subcategory' ? 'active' : '' %>">
          <a href="/subcategory/add" class="menu-link">
            <i class="menu-icon ri ri-add-circle-line"></i>
            <div data-i18n="Create Subcategory">Create Subcategory</div>
          </a>
        </li>
        <li class="menu-item <%= activePage === 'view-subcategory' ? 'active' : '' %>">
          <a href="/subcategory/view" class="menu-link">
            <i class="menu-icon ri ri-list-check-2"></i>
            <div data-i18n="Manage Subcategories">Manage Subcategories</div>
          </a>
        </li>
        <li class="menu-item <%= activePage === 'trash-subcategory' ? 'active' : '' %>">
          <a href="/subcategory/trash" class="menu-link">
            <i class="menu-icon ri ri-archive-line"></i>
            <div data-i18n="Archived Subcategories">Archived Subcategories</div>
          </a>
        </li>
      </ul>
    </li>
    <% } %>

    <% if (canExtraCategories) { %>
      <li class="menu-item <%= ['add-extra-category', 'view-extra-category', 'trash-extra-category'].includes(activePage) ? 'active open' : '' %>">
      <a href="javascript:void(0);" class="menu-link menu-toggle">
        <i class="menu-icon icon-base ri ri-price-tag-3-line"></i>
        <div data-i18n="Extra Categories">Extra Categories</div>
      </a>
      <ul class="menu-sub">
        <li class="menu-item <%= activePage === 'add-extra-category' ? 'active' : '' %>">
          <a href="/extra-category/add" class="menu-link">
            <i class="menu-icon ri ri-add-circle-line"></i>
            <div data-i18n="Create Extra">Create Extra</div>
          </a>
        </li>
        <li class="menu-item <%= activePage === 'view-extra-category' ? 'active' : '' %>">
          <a href="/extra-category/view" class="menu-link">
            <i class="menu-icon ri ri-list-check-2"></i>
            <div data-i18n="Manage Extras">Manage Extras</div>
          </a>
        </li>
        <li class="menu-item <%= activePage === 'trash-extra-category' ? 'active' : '' %>">
          <a href="/extra-category/trash" class="menu-link">
            <i class="menu-icon ri ri-archive-line"></i>
            <div data-i18n="Archived Extras">Archived Extras</div>
          </a>
        </li>
      </ul>
    </li>
    <% } %>

    <% if (canProductView) { %>
      <li class="menu-item <%= ['add-product', 'view-products', 'trash-products'].includes(activePage) ? 'active open' : '' %>">
      <a href="javascript:void(0);" class="menu-link menu-toggle">
        <i class="menu-icon icon-base ri ri-shopping-bag-3-line"></i>
        <div data-i18n="Product Inventory">Product Inventory</div>
      </a>
      <ul class="menu-sub">
        <% if (canProductCreate) { %>
          <li class="menu-item <%= activePage === 'add-product' ? 'active' : '' %>">
            <a href="/products/add" class="menu-link">
              <i class="menu-icon ri ri-add-box-line"></i>
              <div data-i18n="Add New Product">Add New Product</div>
            </a>
          </li>
        <% } %>
        <li class="menu-item <%= activePage === 'view-products' ? 'active' : '' %>">
          <a href="/products/view" class="menu-link">
            <i class="menu-icon ri ri-list-check-2"></i>
            <div data-i18n="All Products">All Products</div>
          </a>
        </li>
        <% if (canProductTrash) { %>
          <li class="menu-item <%= activePage === 'trash-products' ? 'active' : '' %>">
            <a href="/products/trash" class="menu-link">
              <i class="menu-icon ri ri-archive-line"></i>
              <div data-i18n="Archived Products">Archived Products</div>
            </a>
          </li>
        <% } %>
      </ul>
    </li>
    <% } %>

    <li class="menu-header small text-uppercase">
      <span class="menu-header-text" data-i18n="Preferences">Preferences</span>
    </li>

    <li class="menu-item <%= activePage === 'profile' ? 'active' : '' %>">
      <a href="/profile" class="menu-link">
        <i class="menu-icon icon-base ri ri-account-circle-line"></i>
        <div data-i18n="My Profile">My Profile</div>
      </a>
    </li>

    <li class="menu-item <%= activePage === 'change-password' ? 'active' : '' %>">
      <a href="/change-password" class="menu-link">
        <i class="menu-icon icon-base ri ri-shield-keyhole-line"></i>
        <div data-i18n="Security Details">Change Password</div>
      </a>
    </li>
  </ul>
</aside>

<div class="menu-mobile-toggler d-xl-none rounded-1">
  <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large text-bg-secondary p-2 rounded-1">
    <i class="ri ri-menu-line icon-base"></i>
    <i class="ri ri-arrow-right-s-line icon-base"></i>
  </a>
</div>
