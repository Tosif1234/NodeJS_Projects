<script>
    const success = "<%= flashMessages.success.length ? flashMessages.success[0] : '' %>";

    const error = "<%= flashMessages.error.length ? flashMessages.error[0] : '' %>";

    if (success) {
        Swal.fire({
            icon: "success",
            title: "Success",
            text: success,
            timer: 2000,
            showConfirmButton: false
        });
    }

    if (error) {
        Swal.fire({
            icon: "error",
            title: "Error",
            text: error
        });
    }
</script>
