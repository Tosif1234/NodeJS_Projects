<%- include('../../partials/header') %>

<div class="layout-wrapper layout-content-navbar">
  <div class="layout-container">
    <%- include('../../partials/sidebar') %>

    <div class="layout-page">
      <%- include('../../partials/navbar') %>

      <div class="content-wrapper">
        <div class="container-xxl flex-grow-1 container-p-y">
          <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
              <h4 class="fw-bold mb-1">
                <span class="text-muted fw-light">Subcategories /</span> Create Subcategory
              </h4>
              <p class="mb-0 text-muted">Attach a subcategory to an existing active category.</p>
            </div>
            <a href="/subcategory/view" class="btn btn-outline-secondary">
              <i class="ri ri-arrow-left-line me-1"></i>
              Back to List
            </a>
          </div>

          <div class="row g-6">
            <div class="col-xl-8 col-lg-9">
              <div class="card">
                <div class="card-header border-bottom">
                  <div class="d-flex align-items-center gap-3">
                    <div class="avatar">
                      <div class="avatar-initial bg-label-primary rounded">
                        <i class="ri ri-node-tree icon-24px"></i>
                      </div>
                    </div>
                    <div>
                      <h5 class="mb-0">Subcategory Details</h5>
                      <small class="text-muted">Choose the parent category before adding the subcategory name.</small>
                    </div>
                  </div>
                </div>

                <div class="card-body pt-5">
                  <form action="/subcategory/add" method="POST">
                    <div class="row g-5">
                      <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                          <select class="form-select" id="categoryId" name="category" required>
                            <option value="">Select Category</option>
                            <% categories.forEach((item) => { %>
                              <option value="<%= item._id %>"><%= item.category %></option>
                            <% }) %>
                          </select>
                          <label for="categoryId">Parent Category <span class="text-danger">*</span></label>
                        </div>
                      </div>

                      <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                          <input
                            type="text"
                            class="form-control"
                            id="subcategoryName"
                            name="subcategory"
                            placeholder="Mobiles"
                            required />
                          <label for="subcategoryName">Subcategory Name <span class="text-danger">*</span></label>
                        </div>
                      </div>

                      <div class="col-12">
                        <div class="border rounded p-4 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                          <div>
                            <h6 class="mb-1">Publish Status</h6>
                            <small class="text-muted">Active subcategories can be used immediately in product setup.</small>
                          </div>
                          <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" id="statusSwitch" name="isActive" value="true" checked />
                            <label class="form-check-label" for="statusSwitch">Active</label>
                          </div>
                        </div>
                      </div>
                    </div>

                    <div class="d-flex flex-column flex-sm-row justify-content-end gap-3 mt-5 pt-4 border-top">
                      <button type="reset" class="btn btn-outline-secondary">
                        <i class="ri ri-refresh-line me-1"></i>
                        Reset
                      </button>
                      <button type="submit" class="btn btn-primary" <%= categories.length ? '' : 'disabled' %>>
                        <i class="ri ri-add-circle-line me-1"></i>
                        Save Subcategory
                      </button>
                    </div>
                  </form>
                </div>
              </div>
            </div>

            <div class="col-xl-4 col-lg-3">
              <div class="card">
                <div class="card-body">
                  <div class="avatar mb-3">
                    <div class="avatar-initial bg-label-info rounded">
                      <i class="ri ri-information-line icon-24px"></i>
                    </div>
                  </div>
                  <h6 class="mb-2">Setup Tip</h6>
                  <p class="text-muted mb-0">Create categories first, then use subcategories to group products more precisely.</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <%- include('../../partials/footer') %>
        <div class="content-backdrop fade"></div>
      </div>
    </div>
  </div>

  <div class="layout-overlay layout-menu-toggle"></div>
</div>

<%- include('../../partials/scripts') %>
