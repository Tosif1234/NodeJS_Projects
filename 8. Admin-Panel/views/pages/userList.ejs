    <div class="card-datatable">
      <table class="datatables-users table">
  <thead>
    <tr>
      <th>#</th>
      <th>User</th>
      <th>Email</th>
      <th>Role</th>
      <th>Plan</th>
      <th>Status</th>
      <th>Actions</th>
    </tr>
  </thead>

  <tbody>
    <% users.map((user,index)=>{
      const roleIcons = {
        Admin: { icon: 'ri-computer-line', className: 'role-admin' },
        User: { icon: 'ri-user-line', className: 'role-subscriber' },
        Subscriber: { icon: 'ri-user-line', className: 'role-subscriber' },
        Editor: { icon: 'ri-edit-box-line', className: 'role-editor' },
        Author: { icon: 'ri-vip-crown-line', className: 'role-author' },
        Maintainer: { icon: 'ri-pie-chart-2-line', className: 'role-maintainer' }
      };
      const roleMeta = roleIcons[user.role] || { icon: 'ri-user-line', className: 'role-subscriber' };
      const statusClass = user.status === 'Active' ? 'status-active' : user.status === 'Pending' ? 'status-pending' : 'status-inactive';
    %>
      <tr class="user-row">
      <td><%= index + 1 %></td>
      <td>
        <div class="user-profile-cell">
          <img
            src="/uploads/<%= user.Image %>"
            alt="<%= user.fullName %>"
            class="user-list-avatar rounded-circle" />
          <div>
            <div class="user-name user-profile-name"><%= user.fullName %></div>
            <div class="user-profile-handle">@<%= user.email ? user.email.split('@')[0] : 'user' %></div>
          </div>
        </div>
      </td>
      <td class="user-email"><%= user.email %></td>
      <td class="user-role">
        <span class="user-role-wrap <%= roleMeta.className %>">
          <i class="ri <%= roleMeta.icon %>"></i>
          <span><%= user.role %></span>
        </span>
      </td>
      <td class="user-plan"><%= user.plan %></td>
      <td>
        <span class="user-status status-pill <%= statusClass %>">
          <%= user.status %>
        </span>
      </td>
      <td>
  <div class="dropdown">
    <button class="btn btn-icon btn-text-secondary rounded-pill dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
      <i class="icon-base ri ri-more-2-line icon-md"></i>
    </button>

    <ul class="dropdown-menu dropdown-menu-end">
      
      <li>
        <a class="dropdown-item" href="#">
          <i class="ri ri-eye-line me-2"></i> View
        </a>
      </li>

      <li>
        <a class="dropdown-item" href="/users/edit/<%= user._id %>">
  <i class="ri ri-edit-line me-2"></i> Edit
</a>
      </li>

      <li>
        <form action="/users/delete/<%= user._id %>" method="POST" class="js-delete-user-form" data-user-name="<%= user.fullName %>">
  <button type="submit" class="dropdown-item text-danger">
    <i class="ri ri-delete-bin-7-line me-2"></i> Delete
  </button>
</form>
      </li>

    </ul>
  </div>
</td>
    </tr>
   <% }) %>
  </tbody>
</table>
