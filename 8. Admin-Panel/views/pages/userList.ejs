<script>
  (function () {
    const roleFilter = document.getElementById('filterRole');
    const planFilter = document.getElementById('filterPlan');
    const statusFilter = document.getElementById('filterStatus');
    const searchInput = document.getElementById('searchUser');
    const exportBtn = document.getElementById('exportUsersBtn');
    const rows = Array.from(document.querySelectorAll('.user-row'));
    const noUsersFound = document.getElementById('noUsersFound');

    if (!roleFilter || !planFilter || !statusFilter || !searchInput || !exportBtn) {
      return;
    }

    function getText(row, selector) {
      const element = row.querySelector(selector);
      return element ? element.textContent.trim() : '';
    }

    function applyUserFilters() {
      const selectedRole = roleFilter.value.toLowerCase();
      const selectedPlan = planFilter.value.toLowerCase();
      const selectedStatus = statusFilter.value.toLowerCase();
      const searchValue = searchInput.value.trim().toLowerCase();
      let visibleCount = 0;

      rows.forEach(function (row) {
        const role = getText(row, '.user-role').toLowerCase();
        const plan = getText(row, '.user-plan').toLowerCase();
        const status = getText(row, '.user-status').toLowerCase();
        const searchableText = [
          getText(row, '.user-name'),
          getText(row, '.user-email'),
          getText(row, '.user-role'),
          getText(row, '.user-plan'),
          getText(row, '.user-status')
        ].join(' ').toLowerCase();

        const matchesRole = !selectedRole || role === selectedRole;
        const matchesPlan = !selectedPlan || plan === selectedPlan;
        const matchesStatus = !selectedStatus || status === selectedStatus;
        const matchesSearch = !searchValue || searchableText.includes(searchValue);
        const shouldShow = matchesRole && matchesPlan && matchesStatus && matchesSearch;

        row.style.display = shouldShow ? '' : 'none';

        if (shouldShow) {
          visibleCount += 1;
        }
      });

      if (noUsersFound) {
        noUsersFound.classList.toggle('d-none', visibleCount > 0);
      }
    }

    function exportVisibleUsers() {
      const visibleRows = rows.filter(function (row) {
        return row.style.display !== 'none';
      });
      const csvRows = [['Name', 'Email', 'Role', 'Plan', 'Status']];

      visibleRows.forEach(function (row) {
        csvRows.push([
          getText(row, '.user-name'),
          getText(row, '.user-email'),
          getText(row, '.user-role'),
          getText(row, '.user-plan'),
          getText(row, '.user-status')
        ]);
      });

      const csv = csvRows
        .map(function (row) {
          return row.map(function (value) {
            return '"' + value.replace(/"/g, '""') + '"';
          }).join(',');
        })
        .join('\n');

      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');

      link.href = url;
      link.download = 'users.csv';
      link.click();
      URL.revokeObjectURL(url);
    }

    [roleFilter, planFilter, statusFilter].forEach(function (filter) {
      filter.addEventListener('change', applyUserFilters);
    });

    searchInput.addEventListener('input', applyUserFilters);
    searchInput.addEventListener('keyup', applyUserFilters);
    searchInput.addEventListener('search', applyUserFilters);
    exportBtn.addEventListener('click', exportVisibleUsers);
  })();
</script>

