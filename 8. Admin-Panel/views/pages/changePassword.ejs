<%- include('../partials/header') %>

<!-- Layout wrapper -->
<div class="layout-wrapper layout-content-navbar">
  <div class="layout-container">
    <%- include('../partials/sidebar') %>

    <div class="layout-page">
      <%- include('../partials/navbar') %>

      <div class="content-wrapper">
        <div class="container-xxl flex-grow-1 container-p-y">
          <div class="row">
            <div class="col-12">
              <div class="card mb-6 overflow-hidden">
                <div class="card-body p-0">
                  <div class="row g-0">
                    <div class="col-lg-4 bg-label-primary">
                      <div class="h-100 p-5 p-lg-6 d-flex flex-column justify-content-between">
                        <div>
                          <span class="avatar-initial rounded bg-primary text-white d-flex align-items-center justify-content-center mb-5" style="width: 64px; height: 64px;">
                            <i class="icon-base ri ri-shield-keyhole-line icon-32px"></i>
                          </span>
                          <h4 class="mb-2 text-primary">Change Password</h4>
                          <p class="mb-0 text-body">Keep your admin account protected with a fresh password.</p>
                        </div>

                        <div class="d-grid gap-3 mt-6">
                          <div class="d-flex align-items-center gap-3">
                            <span class="badge badge-center rounded-pill bg-primary">
                              <i class="icon-base ri ri-check-line"></i>
                            </span>
                            <span class="small">Use at least 6 characters</span>
                          </div>
                          <div class="d-flex align-items-center gap-3">
                            <span class="badge badge-center rounded-pill bg-primary">
                              <i class="icon-base ri ri-check-line"></i>
                            </span>
                            <span class="small">Confirm your current password</span>
                          </div>
                        </div>
                      </div>
                    </div>

                    <div class="col-lg-8">
                      <div class="p-5 p-lg-6">
                        <div class="mb-5">
                          <h5 class="mb-1">Password Details</h5>
                          <p class="text-body-secondary mb-0">Enter your current password and choose a new one.</p>
                        </div>

                        <form action="/change-password" method="POST" id="changePasswordForm">
                          <div class="row g-5">
                            <div class="col-12">
                              <label class="form-label" for="currentPassword">Current Password</label>
                              <div class="input-group input-group-merge input-group-lg">
                                <span class="input-group-text">
                                  <i class="icon-base ri ri-shield-keyhole-line"></i>
                                </span>
                                <input
                                  type="password"
                                  class="form-control password-field"
                                  id="currentPassword"
                                  name="currentPassword"
                                  placeholder="Current Password"
                                  required
                                  autofocus />
                                <button class="input-group-text password-toggle" type="button" aria-label="Show password">
                                  <i class="icon-base ri ri-eye-off-line"></i>
                                </button>
                              </div>
                            </div>

                            <div class="col-md-6">
                              <label class="form-label" for="newPassword">New Password</label>
                              <div class="input-group input-group-merge input-group-lg">
                                <span class="input-group-text">
                                  <i class="icon-base ri ri-lock-line"></i>
                                </span>
                                <input
                                  type="password"
                                  class="form-control password-field"
                                  id="newPassword"
                                  name="newPassword"
                                  placeholder="New Password"
                                  minlength="6"
                                  required />
                                <button class="input-group-text password-toggle" type="button" aria-label="Show password">
                                  <i class="icon-base ri ri-eye-off-line"></i>
                                </button>
                              </div>
                            </div>

                            <div class="col-md-6">
                              <label class="form-label" for="confirmPassword">Confirm Password</label>
                              <div class="input-group input-group-merge input-group-lg">
                                <span class="input-group-text">
                                  <i class="icon-base ri ri-lock-2-line"></i>
                                </span>
                                <input
                                  type="password"
                                  class="form-control password-field"
                                  id="confirmPassword"
                                  name="confirmPassword"
                                  placeholder="Confirm Password"
                                  minlength="6"
                                  required />
                                <button class="input-group-text password-toggle" type="button" aria-label="Show password">
                                  <i class="icon-base ri ri-eye-off-line"></i>
                                </button>
                              </div>
                            </div>
                          </div>

                          <div class="d-flex flex-column flex-sm-row justify-content-end gap-3 mt-6 pt-4 border-top">
                            <a href="/profile" class="btn btn-outline-secondary btn-lg">Cancel</a>
                            <button type="submit" class="btn btn-primary btn-lg">
                              <i class="icon-base ri ri-save-line me-2"></i>
                              Update Password
                            </button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <%- include('../partials/footer') %>
        <div class="content-backdrop fade"></div>
      </div>
    </div>
  </div>

  <div class="layout-overlay layout-menu-toggle"></div>
</div>

<script>
  document.querySelectorAll('.password-toggle').forEach((button) => {
    button.addEventListener('click', () => {
      const input = button.parentElement.querySelector('.password-field');
      const icon = button.querySelector('i');
      const isVisible = input.type === 'text';

      input.type = isVisible ? 'password' : 'text';
      button.setAttribute('aria-label', isVisible ? 'Show password' : 'Hide password');
      icon.classList.toggle('ri-eye-off-line', isVisible);
      icon.classList.toggle('ri-eye-line', !isVisible);
    });
  });

  const changePasswordForm = document.getElementById('changePasswordForm');

  if (changePasswordForm) {
    changePasswordForm.addEventListener('submit', (event) => {
      const currentPassword = document.getElementById('currentPassword').value;
      const newPasswordInput = document.getElementById('newPassword');
      const newPassword = newPasswordInput.value;

      if (currentPassword === newPassword) {
        event.preventDefault();
        Swal.fire({
          icon: 'error',
          title: 'Invalid Password',
          text: 'New password cannot be the same as your current password.',
          customClass: {
            popup: 'my-swal-popup'
          }
        });
        return;
      }
    });
  }
</script>

<%- include('../partials/scripts') %>
