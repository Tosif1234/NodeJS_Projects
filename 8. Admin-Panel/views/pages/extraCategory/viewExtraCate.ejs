<%- include('../../partials/header') %>

<div class="layout-wrapper layout-content-navbar">
  <div class="layout-container">
    <%- include('../../partials/sidebar') %>

    <div class="layout-page">
      <%- include('../../partials/navbar') %>

      <div class="content-wrapper">
        <div class="container-xxl flex-grow-1 container-p-y">
          <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
              <h4 class="fw-bold mb-1">
                <span class="text-muted fw-light">Extra Categories /</span> Manage Extras
              </h4>
              <p class="mb-0 text-muted">Review extra category records and their category path.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
              <a href="/extra-category/trash" class="btn btn-outline-secondary">
                <i class="ri ri-archive-line me-1"></i>
                Archive
              </a>
              <a href="/extra-category/add" class="btn btn-primary">
                <i class="ri ri-add-line me-1"></i>
                Add Extra
              </a>
            </div>
          </div>

          <div class="card">
            <div class="card-header border-bottom d-flex align-items-center gap-3">
              <div class="avatar">
                <div class="avatar-initial bg-label-primary rounded">
                  <i class="ri ri-price-tag-3-line icon-24px"></i>
                </div>
              </div>
              <div>
                <h5 class="mb-0">Extra Category List</h5>
                <small class="text-muted">Showing <%= extraCategories ? extraCategories.length : 0 %> active records</small>
              </div>
            </div>

            <div class="card-body p-0">
              <div class="table-responsive text-nowrap">
                <table class="table table-hover align-middle mb-0">
                  <thead>
                    <tr>
                      <th>#</th>
                      <th>Extra Category</th>
                      <th>Category</th>
                      <th>Subcategory</th>
                      <th>Status</th>
                      <th>Created</th>
                      <th class="text-end">Actions</th>
                    </tr>
                  </thead>

                  <tbody class="table-border-bottom-0">
                    <% if (extraCategories && extraCategories.length > 0) { %>
                      <% extraCategories.forEach((item, index) => { %>
                        <tr>
                          <td class="text-muted"><%= index + 1 %></td>
                          <td>
                            <div class="d-flex align-items-center">
                              <div class="avatar avatar-sm me-3">
                                <div class="avatar-initial bg-label-secondary rounded">
                                  <i class="ri ri-price-tag-3-line"></i>
                                </div>
                              </div>
                              <span class="fw-medium text-heading"><%= item.extraCategory %></span>
                            </div>
                          </td>
                          <td><%= item.category ? item.category.category : '-' %></td>
                          <td><%= item.subcategory ? item.subcategory.subcategory : '-' %></td>
                          <td>
                            <% if (item.isActive) { %>
                              <span class="badge bg-label-success">Active</span>
                            <% } else { %>
                              <span class="badge bg-label-danger">Inactive</span>
                            <% } %>
                          </td>
                          <td><%= item.createdAt ? item.createdAt.toDateString() : '-' %></td>
                          <td class="text-end">
                            <div class="dropdown">
                              <button class="btn btn-icon btn-text-secondary rounded-pill dropdown-toggle hide-arrow" data-bs-toggle="dropdown" type="button">
                                <i class="icon-base ri ri-more-2-line icon-md"></i>
                              </button>
                              <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                  <a class="dropdown-item" href="/extra-category/edit/<%= item._id %>">
                                    <i class="ri ri-edit-line me-2"></i>
                                    Edit
                                  </a>
                                </li>
                                <li>
                                  <a
                                    class="dropdown-item text-danger"
                                    href="/extra-category/delete/<%= item._id %>"
                                    onclick="confirmAction(event, this.href, 'archive', 'extra category')">
                                    <i class="ri ri-delete-bin-7-line me-2"></i>
                                    Archive
                                  </a>
                                </li>
                              </ul>
                            </div>
                          </td>
                        </tr>
                      <% }) %>
                    <% } else { %>
                      <tr>
                        <td colspan="7" class="text-center py-5">
                          <div class="avatar avatar-xl mx-auto mb-3">
                            <div class="avatar-initial bg-label-secondary rounded-circle">
                              <i class="ri ri-price-tag-3-line icon-28px"></i>
                            </div>
                          </div>
                          <h6 class="mb-1">No Extra Categories Found</h6>
                          <p class="text-muted mb-3">Create an extra category to add one more catalog level.</p>
                          <a href="/extra-category/add" class="btn btn-primary">
                            <i class="ri ri-add-line me-1"></i>
                            Add Extra
                          </a>
                        </td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

        <%- include('../../partials/footer') %>
        <div class="content-backdrop fade"></div>
      </div>
    </div>
  </div>

  <div class="layout-overlay layout-menu-toggle"></div>
</div>

<%- include('../../partials/scripts') %>
