<%- include('../../partials/header') %>

<div class="layout-wrapper layout-content-navbar">
  <div class="layout-container">
    <%- include('../../partials/sidebar') %>

    <div class="layout-page">
      <%- include('../../partials/navbar') %>

      <div class="content-wrapper">
        <div class="container-xxl flex-grow-1 container-p-y">
          <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
              <h4 class="fw-bold mb-1">
                <span class="text-muted fw-light">Products /</span> Edit Product
              </h4>
              <p class="mb-0 text-muted">Update product category path, name, pricing, and status.</p>
            </div>
            <a href="/products/view" class="btn btn-outline-secondary">
              <i class="ri ri-arrow-left-line me-1"></i>
              Back to List
            </a>
          </div>

          <div class="row g-6">
            <div class="col-xl-8 col-lg-9">
              <div class="card">
                <div class="card-header border-bottom">
                  <div class="d-flex align-items-center gap-3">
                    <div class="avatar">
                      <div class="avatar-initial bg-label-warning rounded">
                        <i class="ri ri-edit-box-line icon-24px"></i>
                      </div>
                    </div>
                    <div>
                      <h5 class="mb-0">Edit Details</h5>
                      <small class="text-muted">Changes are applied after saving this form.</small>
                    </div>
                  </div>
                </div>

                <div class="card-body pt-5">
                  <form action="/products/edit/<%= product._id %>" method="POST">
                    <div class="row g-5">
                      <div class="col-md-4">
                        <div class="form-floating form-floating-outline">
                          <select class="form-select js-category-select" id="categoryId" name="category" required>
                            <option value="">Select Category</option>
                            <% categories.forEach((item) => { %>
                              <option value="<%= item._id %>" <%= product.category && product.category._id.toString() === item._id.toString() ? 'selected' : '' %>>
                                <%= item.category %>
                              </option>
                            <% }) %>
                          </select>
                          <label for="categoryId">Category <span class="text-danger">*</span></label>
                        </div>
                      </div>

                      <div class="col-md-4">
                        <div class="form-floating form-floating-outline">
                          <select class="form-select js-subcategory-select" id="subcategoryId" name="subcategory" required>
                            <option value="">Select Subcategory</option>
                            <% subcategories.forEach((item) => { %>
                              <option
                                value="<%= item._id %>"
                                data-category="<%= item.category ? item.category._id : '' %>"
                                <%= product.subcategory && product.subcategory._id.toString() === item._id.toString() ? 'selected' : '' %>>
                                <%= item.subcategory %>
                              </option>
                            <% }) %>
                          </select>
                          <label for="subcategoryId">Subcategory <span class="text-danger">*</span></label>
                        </div>
                      </div>

                      <div class="col-md-4">
                        <div class="form-floating form-floating-outline">
                          <select class="form-select js-extra-select" id="extraCategoryId" name="extraCategory" required>
                            <option value="">Select Extra</option>
                            <% extraCategories.forEach((item) => { %>
                              <option
                                value="<%= item._id %>"
                                data-category="<%= item.category ? item.category._id : '' %>"
                                data-subcategory="<%= item.subcategory ? item.subcategory._id : '' %>"
                                <%= product.extraCategory && product.extraCategory._id.toString() === item._id.toString() ? 'selected' : '' %>>
                                <%= item.extraCategory %>
                              </option>
                            <% }) %>
                          </select>
                          <label for="extraCategoryId">Extra Category <span class="text-danger">*</span></label>
                        </div>
                      </div>

                      <div class="col-md-8">
                        <div class="form-floating form-floating-outline">
                          <input type="text" class="form-control" id="productName" name="productName" value="<%= product.productName || '' %>" placeholder="iPhone 15" />
                          <label for="productName">Product Name</label>
                        </div>
                      </div>

                      <div class="col-md-4">
                        <div class="form-floating form-floating-outline">
                          <input type="number" class="form-control" id="price" name="price" value="<%= product.price %>" min="0" step="0.01" placeholder="999" required />
                          <label for="price">Price <span class="text-danger">*</span></label>
                        </div>
                      </div>

                      <div class="col-12">
                        <div class="border rounded p-4 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                          <div>
                            <h6 class="mb-1">Publish Status</h6>
                            <small class="text-muted">Inactive products remain saved but are hidden from active use.</small>
                          </div>
                          <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" id="statusSwitch" name="isActive" value="true" <%= product.isActive ? "checked" : "" %> />
                            <label class="form-check-label" for="statusSwitch">Active</label>
                          </div>
                        </div>
                      </div>
                    </div>

                    <div class="d-flex flex-column flex-sm-row justify-content-end gap-3 mt-5 pt-4 border-top">
                      <a href="/products/view" class="btn btn-outline-secondary">Cancel</a>
                      <button type="submit" class="btn btn-primary">
                        <i class="ri ri-save-line me-1"></i>
                        Update Product
                      </button>
                    </div>
                  </form>
                </div>
              </div>
            </div>

            <div class="col-xl-4 col-lg-3">
              <div class="card">
                <div class="card-body">
                  <div class="avatar mb-3">
                    <div class="avatar-initial bg-label-primary rounded">
                      <i class="ri ri-shopping-bag-3-line icon-24px"></i>
                    </div>
                  </div>
                  <h6 class="mb-2">Current Product</h6>
                  <p class="text-heading fw-medium mb-1"><%= product.productName || (product.extraCategory ? product.extraCategory.extraCategory : 'Product') %></p>
                  <small class="text-muted d-block mb-2">
                    <%= product.category ? product.category.category : '-' %> /
                    <%= product.subcategory ? product.subcategory.subcategory : '-' %> /
                    <%= product.extraCategory ? product.extraCategory.extraCategory : '-' %>
                  </small>
                  <h5 class="mb-2">$<%= Number(product.price).toFixed(2) %></h5>
                  <span class="badge <%= product.isActive ? 'bg-label-success' : 'bg-label-danger' %>">
                    <%= product.isActive ? 'Active' : 'Inactive' %>
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <%- include('../../partials/footer') %>
        <div class="content-backdrop fade"></div>
      </div>
    </div>
  </div>

  <div class="layout-overlay layout-menu-toggle"></div>
</div>

<%- include('../../partials/scripts') %>
