<%- include('../../partials/header') %>

<div class="layout-wrapper layout-content-navbar">
  <div class="layout-container">
    <%- include('../../partials/sidebar') %>

    <div class="layout-page">
      <%- include('../../partials/navbar') %>

      <div class="content-wrapper">
        <div class="container-xxl flex-grow-1 container-p-y">
          <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
              <h4 class="fw-bold mb-1">
                <span class="text-muted fw-light">Products /</span> Edit Product
              </h4>
              <p class="mb-0 text-muted">Update product category path, name, pricing, image, and status.</p>
            </div>
            <a href="/products/view" class="btn btn-outline-secondary">
              <i class="ri ri-arrow-left-line me-1"></i>
              Back to List
            </a>
          </div>

          <div class="row g-6">
            <div class="col-xl-8 col-lg-9">
              <div class="card">
                <div class="card-header border-bottom">
                  <div class="d-flex align-items-center gap-3">
                    <div class="avatar">
                      <div class="avatar-initial bg-label-warning rounded">
                        <i class="ri ri-edit-box-line icon-24px"></i>
                      </div>
                    </div>
                    <div>
                      <h5 class="mb-0">Edit Details</h5>
                      <small class="text-muted">Choose category path, add image and edit pricing details.</small>
                    </div>
                  </div>
                </div>

                <div class="card-body pt-5">
                  <form action="/products/edit/<%= product._id %>" method="POST" enctype="multipart/form-data" id="editProductForm">
                    <div class="row g-5">
                      <div class="col-md-4">
                        <div class="form-floating form-floating-outline">
                          <select class="form-select js-category-select" id="categoryId" name="category" required>
                            <option value="">Select Category</option>
                            <% categories.forEach((item) => { %>
                              <option value="<%= item._id %>" <%= product.category && product.category._id.toString() === item._id.toString() ? 'selected' : '' %>>
                                <%= item.category %>
                              </option>
                            <% }) %>
                          </select>
                          <label for="categoryId">Category <span class="text-danger">*</span></label>
                        </div>
                      </div>

                      <div class="col-md-4">
                        <div class="form-floating form-floating-outline">
                          <select class="form-select js-subcategory-select" id="subcategoryId" name="subcategory" required>
                            <option value="">Select Subcategory</option>
                            <% subcategories.forEach((item) => { %>
                              <option
                                value="<%= item._id %>"
                                data-category="<%= item.category ? item.category._id : '' %>"
                                <%= product.subcategory && product.subcategory._id.toString() === item._id.toString() ? 'selected' : '' %>>
                                <%= item.subcategory %>
                              </option>
                            <% }) %>
                          </select>
                          <label for="subcategoryId">Subcategory <span class="text-danger">*</span></label>
                        </div>
                      </div>

                      <div class="col-md-4">
                        <div class="form-floating form-floating-outline">
                          <select class="form-select js-extra-select" id="extraCategoryId" name="extraCategory" required>
                            <option value="">Select Extra</option>
                            <% extraCategories.forEach((item) => { %>
                              <option
                                value="<%= item._id %>"
                                data-category="<%= item.category ? item.category._id : '' %>"
                                data-subcategory="<%= item.subcategory ? item.subcategory._id : '' %>"
                                <%= product.extraCategory && product.extraCategory._id.toString() === item._id.toString() ? 'selected' : '' %>>
                                <%= item.extraCategory %>
                              </option>
                            <% }) %>
                          </select>
                          <label for="extraCategoryId">Extra Category <span class="text-danger">*</span></label>
                        </div>
                      </div>

                      <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                          <input type="number" class="form-control" id="price" name="price" value="<%= product.price %>" min="0" step="0.01" placeholder="999" required />
                          <label for="price">Price <span class="text-danger">*</span></label>
                        </div>
                      </div>

                      <div class="col-12">
                        <div class="product-upload-panel">
                          <div class="product-upload-preview" id="productImagePreviewBox">
                            <% if (product.productImage) { %>
                              <img id="productImagePreview" src="/uploads/<%= product.productImage %>" alt="Selected product preview" />
                              <div id="productImagePlaceholder" class="product-upload-placeholder d-none">
                                <i class="ri ri-image-add-line"></i>
                                <span>Product Image</span>
                              </div>
                            <% } else { %>
                              <img id="productImagePreview" class="d-none" alt="Selected product preview" />
                              <div id="productImagePlaceholder" class="product-upload-placeholder">
                                <i class="ri ri-image-add-line"></i>
                                <span>Product Image</span>
                              </div>
                            <% } %>
                          </div>

                          <div class="product-upload-content">
                            <div>
                              <h6 class="mb-1">Product Image</h6>
                              <p class="text-muted mb-0">Upload a new product image. You can preview, remove, or change it before saving.</p>
                            </div>

                            <div class="d-flex flex-wrap gap-2">
                              <label for="productImage" class="btn btn-primary mb-0">
                                <i class="ri ri-upload-2-line me-1"></i>
                                Choose Image
                              </label>
                              <button type="button" class="btn btn-outline-secondary <%= product.productImage ? '' : 'd-none' %>" id="removeProductImage">
                                <i class="ri ri-close-line me-1"></i>
                                Remove
                              </button>
                            </div>

                            <input type="file" id="productImage" name="productImage" class="visually-hidden" accept="image/png, image/jpeg, image/webp, image/gif" />
                            <input type="hidden" name="removeImage" id="removeImageFlag" value="false" />
                            <small class="text-muted">PNG, JPG, WEBP, or GIF images are supported.</small>
                          </div>
                        </div>
                      </div>

                      <div class="col-12">
                        <div class="border rounded p-4 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                          <div>
                            <h6 class="mb-1">Publish Status</h6>
                            <small class="text-muted">Inactive products remain saved but are hidden from active use.</small>
                          </div>
                          <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" id="statusSwitch" name="isActive" value="true" <%= product.isActive ? "checked" : "" %> />
                            <label class="form-check-label" for="statusSwitch">Active</label>
                          </div>
                        </div>
                      </div>
                    </div>

                    <div class="d-flex flex-column flex-sm-row justify-content-end gap-3 mt-5 pt-4 border-top">
                      <button type="reset" class="btn btn-outline-secondary">
                        <i class="ri ri-refresh-line me-1"></i>
                        Reset
                      </button>
                      <button type="submit" class="btn btn-primary">
                        <i class="ri ri-save-line me-1"></i>
                        Update Product
                      </button>
                    </div>
                  </form>
                </div>
              </div>
            </div>

            <div class="col-xl-4 col-lg-3">
              <div class="card">
                <div class="card-body">
                  <div class="avatar mb-3">
                    <div class="avatar-initial bg-label-primary rounded">
                      <i class="ri ri-shopping-bag-3-line icon-24px"></i>
                    </div>
                  </div>
                  <h6 class="mb-2">Current Product</h6>
                  <p class="text-heading fw-medium mb-1"><%= product.productName || (product.extraCategory ? product.extraCategory.extraCategory : 'Product') %></p>
                  <small class="text-muted d-block mb-2">
                    <%= product.category ? product.category.category : '-' %> /
                    <%= product.subcategory ? product.subcategory.subcategory : '-' %> /
                    <%= product.extraCategory ? product.extraCategory.extraCategory : '-' %>
                  </small>
                  <h5 class="mb-2">$<%= Number(product.price).toFixed(2) %></h5>
                  <span class="badge <%= product.isActive ? 'bg-label-success' : 'bg-label-danger' %>">
                    <%= product.isActive ? 'Active' : 'Inactive' %>
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <%- include('../../partials/footer') %>
        <div class="content-backdrop fade"></div>
      </div>
    </div>
  </div>

  <div class="layout-overlay layout-menu-toggle"></div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const imageInput = document.getElementById('productImage');
    const imagePreview = document.getElementById('productImagePreview');
    const imagePlaceholder = document.getElementById('productImagePlaceholder');
    const removeButton = document.getElementById('removeProductImage');
    const removeImageFlag = document.getElementById('removeImageFlag');
    const form = imageInput ? imageInput.closest('form') : null;
    let previewUrl = '';

    if (!imageInput || !imagePreview || !imagePlaceholder || !removeButton || !removeImageFlag) {
      return;
    }

    function clearPreview() {
      if (previewUrl) {
        URL.revokeObjectURL(previewUrl);
        previewUrl = '';
      }

      imageInput.value = '';
      imagePreview.src = '';
      imagePreview.classList.add('d-none');
      imagePlaceholder.classList.remove('d-none');
      removeButton.classList.add('d-none');
      removeImageFlag.value = 'true';
    }

    imageInput.addEventListener('change', function () {
      const file = imageInput.files && imageInput.files[0];

      if (!file) {
        return;
      }

      if (previewUrl) {
        URL.revokeObjectURL(previewUrl);
      }

      previewUrl = URL.createObjectURL(file);
      imagePreview.src = previewUrl;
      imagePreview.classList.remove('d-none');
      imagePlaceholder.classList.add('d-none');
      removeButton.classList.remove('d-none');
      removeImageFlag.value = 'false';
    });

    removeButton.addEventListener('click', clearPreview);

    if (form) {
      form.addEventListener('reset', function () {
        setTimeout(function() {
          if (previewUrl) {
            URL.revokeObjectURL(previewUrl);
            previewUrl = '';
          }
          // Restore to initial state of product image
          <% if (product.productImage) { %>
            imagePreview.src = '/uploads/<%= product.productImage %>';
            imagePreview.classList.remove('d-none');
            imagePlaceholder.classList.add('d-none');
            removeButton.classList.remove('d-none');
            removeImageFlag.value = 'false';
          <% } else { %>
            imagePreview.src = '';
            imagePreview.classList.add('d-none');
            imagePlaceholder.classList.remove('d-none');
            removeButton.classList.add('d-none');
            removeImageFlag.value = 'false';
          <% } %>
          imageInput.value = '';
        }, 0);
      });
    }
  });
</script>

<%- include('../../partials/scripts') %>
