<%- include('../../partials/header') %>

<div class="layout-wrapper layout-content-navbar">
  <%
    var checkPermission = typeof canPermission === 'function' ? canPermission : function () { return false; };
    var canCreateProduct = checkPermission('products:create');
    var canEditProduct = checkPermission('products:edit');
    var canDeleteProduct = checkPermission('products:delete');
    var canViewProductTrash = checkPermission('products:trash');
    var showProductActions = canEditProduct || canDeleteProduct;
  %>
  <div class="layout-container">
    <%- include('../../partials/sidebar') %>

    <div class="layout-page">
      <%- include('../../partials/navbar') %>

      <div class="content-wrapper">
        <div class="container-xxl flex-grow-1 container-p-y">
          <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
              <h4 class="fw-bold mb-1">
                <span class="text-muted fw-light">Products /</span> Manage Products
              </h4>
              <p class="mb-0 text-muted">Review inventory items, pricing, category path, and availability.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
              <% if (canViewProductTrash) { %>
                <a href="/products/trash" class="btn btn-outline-secondary">
                  <i class="ri ri-archive-line me-1"></i>
                  Archive
                </a>
              <% } %>
              <% if (canCreateProduct) { %>
                <a href="/products/add" class="btn btn-primary">
                  <i class="ri ri-add-line me-1"></i>
                  Add Product
                </a>
              <% } %>
            </div>
          </div>

          <div class="card product-view-card">
            <div class="card-header border-bottom d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
              <div class="d-flex align-items-center gap-3">
                <div class="avatar">
                  <div class="avatar-initial bg-label-primary rounded">
                    <i class="ri ri-shopping-bag-3-line icon-24px"></i>
                  </div>
                </div>
                <div>
                  <h5 class="mb-0">Product List</h5>
                  <small class="text-muted">Showing <%= products ? products.length : 0 %> active records</small>
                </div>
              </div>

              <div class="product-view-toggle" role="group" aria-label="Product display mode">
                <button type="button" class="product-view-toggle-btn active" data-product-view="card" aria-pressed="true">
                  <i class="ri ri-layout-grid-line"></i>
                  <span>Card View</span>
                </button>
                <button type="button" class="product-view-toggle-btn" data-product-view="list" aria-pressed="false">
                  <i class="ri ri-list-check"></i>
                  <span>List View</span>
                </button>
              </div>
            </div>

            <div class="card-body">
              <% if (products && products.length > 0) { %>
                <div class="product-card-view" data-product-panel="card">
                  <div class="row g-4">
                    <% products.forEach((item) => {
                      const productTitle = item.productName || (item.extraCategory ? item.extraCategory.extraCategory : 'Product');
                      const productImage = item.productImage ? '/uploads/' + item.productImage : '';
                    %>
                      <div class="col-sm-6 col-xl-4">
                        <article class="product-card-item">
                          <div class="product-card-media">
                            <% if (productImage) { %>
                              <img src="<%= productImage %>" alt="<%= productTitle %>" />
                            <% } else { %>
                              <div class="product-image-placeholder">
                                <i class="ri ri-image-line"></i>
                              </div>
                            <% } %>
                            <span class="product-card-status badge <%= item.isActive ? 'bg-label-success' : 'bg-label-danger' %>">
                              <%= item.isActive ? 'Active' : 'Inactive' %>
                            </span>
                          </div>

                          <div class="product-card-body">
                            <div class="d-flex justify-content-between align-items-start gap-3">
                              <div>
                                <h6 class="product-card-title"><%= productTitle %></h6>
                                <p class="text-muted mb-0">Created <%= item.createdAt ? item.createdAt.toDateString() : '-' %></p>
                              </div>
                              <% if (showProductActions) { %>
                                <div class="dropdown">
                                  <button class="btn btn-icon btn-text-secondary rounded-pill dropdown-toggle hide-arrow" data-bs-toggle="dropdown" type="button" aria-label="Product actions">
                                    <i class="icon-base ri ri-more-2-line icon-md"></i>
                                  </button>
                                  <ul class="dropdown-menu dropdown-menu-end">
                                    <% if (canEditProduct) { %>
                                      <li>
                                        <a class="dropdown-item" href="/products/edit/<%= item._id %>">
                                          <i class="ri ri-edit-line me-2"></i>
                                          Edit
                                        </a>
                                      </li>
                                    <% } %>
                                    <% if (canDeleteProduct) { %>
                                      <li>
                                        <a
                                          class="dropdown-item text-danger"
                                          href="/products/delete/<%= item._id %>"
                                          onclick="confirmAction(event, this.href, 'archive', 'product')">
                                          <i class="ri ri-delete-bin-7-line me-2"></i>
                                          Archive
                                        </a>
                                      </li>
                                    <% } %>
                                  </ul>
                                </div>
                              <% } %>
                            </div>

                            <div class="product-card-meta">
                              <div>
                                <span>Category</span>
                                <strong><%= item.category ? item.category.category : '-' %></strong>
                              </div>
                              <div>
                                <span>Subcategory</span>
                                <strong><%= item.subcategory ? item.subcategory.subcategory : '-' %></strong>
                              </div>
                              <div>
                                <span>Extra</span>
                                <strong><%= item.extraCategory ? item.extraCategory.extraCategory : '-' %></strong>
                              </div>
                            </div>

                            <div class="product-card-footer">
                              <span class="text-muted">Price</span>
                              <strong>$<%= Number(item.price || 0).toFixed(2) %></strong>
                            </div>
                          </div>
                        </article>
                      </div>
                    <% }) %>
                  </div>
                </div>

                <div class="product-list-view d-none" data-product-panel="list">
                  <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                  <thead>
                    <tr>
                      <th>Product</th>
                      <th>Category</th>
                      <th>Subcategory</th>
                      <th>Extra</th>
                      <th>Price</th>
                      <th>Status</th>
                      <th>Created</th>
                      <% if (showProductActions) { %>
                        <th class="text-end">Actions</th>
                      <% } %>
                    </tr>
                  </thead>

                  <tbody class="table-border-bottom-0">
                      <% products.forEach((item, index) => { %>
                        <% const productTitle = item.productName || (item.extraCategory ? item.extraCategory.extraCategory : 'Product'); %>
                        <tr>
                          <td>
                            <div class="d-flex align-items-center">
                              <% if (item.productImage) { %>
                                <img src="/uploads/<%= item.productImage %>" alt="<%= productTitle %>" class="product-list-image me-3" />
                              <% } else { %>
                                <div class="product-list-placeholder me-3">
                                  <i class="ri ri-image-line"></i>
                                </div>
                              <% } %>
                              <div>
                                <span class="fw-medium text-heading d-block"><%= productTitle %></span>
                                <small class="text-muted">#<%= index + 1 %></small>
                              </div>
                            </div>
                          </td>
                          <td><%= item.category ? item.category.category : '-' %></td>
                          <td><%= item.subcategory ? item.subcategory.subcategory : '-' %></td>
                          <td><%= item.extraCategory ? item.extraCategory.extraCategory : '-' %></td>
                          <td class="fw-medium">$<%= Number(item.price || 0).toFixed(2) %></td>
                          <td>
                            <% if (item.isActive) { %>
                              <span class="badge bg-label-success">Active</span>
                            <% } else { %>
                              <span class="badge bg-label-danger">Inactive</span>
                            <% } %>
                          </td>
                          <td><%= item.createdAt ? item.createdAt.toDateString() : '-' %></td>
                          <% if (showProductActions) { %>
                            <td class="text-end">
                              <div class="dropdown">
                                <button class="btn btn-icon btn-text-secondary rounded-pill dropdown-toggle hide-arrow" data-bs-toggle="dropdown" type="button">
                                  <i class="icon-base ri ri-more-2-line icon-md"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                  <% if (canEditProduct) { %>
                                    <li>
                                      <a class="dropdown-item" href="/products/edit/<%= item._id %>">
                                        <i class="ri ri-edit-line me-2"></i>
                                        Edit
                                      </a>
                                    </li>
                                  <% } %>
                                  <% if (canDeleteProduct) { %>
                                    <li>
                                      <a
                                        class="dropdown-item text-danger"
                                        href="/products/delete/<%= item._id %>"
                                        onclick="confirmAction(event, this.href, 'archive', 'product')">
                                        <i class="ri ri-delete-bin-7-line me-2"></i>
                                        Archive
                                      </a>
                                    </li>
                                  <% } %>
                                </ul>
                              </div>
                            </td>
                          <% } %>
                        </tr>
                      <% }) %>
                  </tbody>
                </table>
                  </div>
                </div>
              <% } else { %>
                <div class="text-center py-5">
                  <div class="avatar avatar-xl mx-auto mb-3">
                    <div class="avatar-initial bg-label-secondary rounded-circle">
                      <i class="ri ri-shopping-bag-3-line icon-28px"></i>
                    </div>
                  </div>
                  <h6 class="mb-1">No Products Found</h6>
                  <p class="text-muted mb-3">Create your first product to start building inventory.</p>
                  <% if (canCreateProduct) { %>
                    <a href="/products/add" class="btn btn-primary">
                      <i class="ri ri-add-line me-1"></i>
                      Add Product
                    </a>
                  <% } %>
                </div>
              <% } %>
              </div>
            </div>
          </div>
        </div>

        <%- include('../../partials/footer') %>
        <div class="content-backdrop fade"></div>
      </div>
    </div>
  </div>

  <div class="layout-overlay layout-menu-toggle"></div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const toggleButtons = Array.from(document.querySelectorAll('[data-product-view]'));
    const panels = Array.from(document.querySelectorAll('[data-product-panel]'));
    const storageKey = 'adminProductViewMode';

    if (!toggleButtons.length || !panels.length) {
      return;
    }

    function setProductView(mode) {
      const nextMode = mode === 'list' ? 'list' : 'card';

      toggleButtons.forEach(function (button) {
        const isActive = button.dataset.productView === nextMode;
        button.classList.toggle('active', isActive);
        button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });

      panels.forEach(function (panel) {
        panel.classList.toggle('d-none', panel.dataset.productPanel !== nextMode);
      });

      localStorage.setItem(storageKey, nextMode);
    }

    toggleButtons.forEach(function (button) {
      button.addEventListener('click', function () {
        setProductView(button.dataset.productView);
      });
    });

    setProductView(localStorage.getItem(storageKey) || 'card');
  });
</script>

<%- include('../../partials/scripts') %>
