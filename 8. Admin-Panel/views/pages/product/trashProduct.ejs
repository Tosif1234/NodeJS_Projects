<%- include('../../partials/header') %>

<div class="layout-wrapper layout-content-navbar">
  <div class="layout-container">
    <%- include('../../partials/sidebar') %>

    <div class="layout-page">
      <%- include('../../partials/navbar') %>

      <div class="content-wrapper">
        <div class="container-xxl flex-grow-1 container-p-y">
          <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
              <h4 class="fw-bold mb-1">
                <span class="text-muted fw-light">Products /</span> Archive
              </h4>
              <p class="mb-0 text-muted">Restore archived products or remove inventory records permanently.</p>
            </div>
            <a href="/products/view" class="btn btn-primary">
              <i class="ri ri-arrow-left-line me-1"></i>
              Back to Active
            </a>
          </div>

          <div class="card">
            <div class="card-header border-bottom d-flex align-items-center gap-3">
              <div class="avatar">
                <div class="avatar-initial bg-label-warning rounded">
                  <i class="ri ri-archive-line icon-24px"></i>
                </div>
              </div>
              <div>
                <h5 class="mb-0">Archived Products</h5>
                <small class="text-muted">Showing <%= products ? products.length : 0 %> archived records</small>
              </div>
            </div>

            <div class="card-body p-0">
              <div class="table-responsive text-nowrap">
                <table class="table table-hover align-middle mb-0">
                  <thead>
                    <tr>
                      <th>Product</th>
                      <th>Category</th>
                      <th>Subcategory</th>
                      <th>Extra</th>
                      <th>Price</th>
                      <th>Status</th>
                      <th class="text-end">Actions</th>
                    </tr>
                  </thead>

                  <tbody class="table-border-bottom-0">
                    <% if (products && products.length > 0) { %>
                      <% products.forEach(item => { %>
                        <tr>
                          <td>
                            <div class="d-flex align-items-center">
                              <div class="avatar avatar-sm me-3">
                                <div class="avatar-initial bg-label-secondary rounded">
                                  <i class="ri ri-shopping-bag-line"></i>
                                </div>
                              </div>
                              <span class="fw-medium text-heading"><%= item.productName || (item.extraCategory ? item.extraCategory.extraCategory : 'Product') %></span>
                            </div>
                          </td>
                          <td><%= item.category ? item.category.category : '-' %></td>
                          <td><%= item.subcategory ? item.subcategory.subcategory : '-' %></td>
                          <td><%= item.extraCategory ? item.extraCategory.extraCategory : '-' %></td>
                          <td class="fw-medium">$<%= Number(item.price || 0).toFixed(2) %></td>
                          <td>
                            <span class="badge bg-label-warning">Archived</span>
                          </td>
                          <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                              <a
                                href="/products/restore/<%= item._id %>"
                                class="btn btn-sm btn-outline-success"
                                onclick="confirmAction(event, this.href, 'restore', 'product')">
                                <i class="ri ri-arrow-go-back-line me-1"></i>
                                Restore
                              </a>
                              <a
                                href="/products/permanent-delete/<%= item._id %>"
                                class="btn btn-sm btn-outline-danger"
                                onclick="confirmAction(event, this.href, 'delete', 'product')">
                                <i class="ri ri-delete-bin-7-line me-1"></i>
                                Delete
                              </a>
                            </div>
                          </td>
                        </tr>
                      <% }) %>
                    <% } else { %>
                      <tr>
                        <td colspan="7" class="text-center py-5">
                          <div class="avatar avatar-xl mx-auto mb-3">
                            <div class="avatar-initial bg-label-secondary rounded-circle">
                              <i class="ri ri-archive-2-line icon-28px"></i>
                            </div>
                          </div>
                          <h6 class="mb-1">Archive is Empty</h6>
                          <p class="text-muted mb-0">Archived products will appear here.</p>
                        </td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

        <%- include('../../partials/footer') %>
        <div class="content-backdrop fade"></div>
      </div>
    </div>
  </div>

  <div class="layout-overlay layout-menu-toggle"></div>
</div>

<%- include('../../partials/scripts') %>
